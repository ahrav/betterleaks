@@ -0,0 +1,245 @@
+#!/usr/bin/env python3
+"""Small protocol-v1 exerciser used by t4218-betterleaks-engine.sh."""
+
+import argparse
+import base64
+import hashlib
+import json
+import os
+import struct
+import subprocess
+import sys
+
+MAX_FRAME = 16 << 20
+
+
+def frame(tag, batch_id, payload=b""):
+    body = tag + struct.pack(">Q", batch_id) + payload
+    return struct.pack(">I", len(body)) + body
+
+
+class Decoder:
+    def __init__(self, data):
+        self.data = data
+        self.pos = 0
+
+    def take(self, size):
+        if len(self.data) - self.pos < size:
+            raise ValueError("truncated payload")
+        value = self.data[self.pos:self.pos + size]
+        self.pos += size
+        return value
+
+    def u32(self):
+        return struct.unpack(">I", self.take(4))[0]
+
+    def u64(self):
+        return struct.unpack(">Q", self.take(8))[0]
+
+    def bytes(self):
+        return self.take(self.u32())
+
+    def done(self):
+        if self.pos != len(self.data):
+            raise ValueError("trailing payload")
+
+
+class Client:
+    def __init__(self, repo):
+        self.proc = subprocess.Popen(
+            ["git", "-C", repo, "betterleaks--diff-engine", "--protocol=1"],
+            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        )
+        tag, batch, payload = self.read()
+        if tag != b"HELO" or batch or len(payload) != 6:
+            raise ValueError("invalid HELO")
+        version, self.oid_len, all_status, copies = struct.unpack(">HHBB", payload)
+        if version != 1 or self.oid_len not in (20, 32) or all_status or copies:
+            raise ValueError("unexpected capabilities")
+
+    def read(self):
+        prefix = self.proc.stdout.read(4)
+        if len(prefix) != 4:
+            raise ValueError("unexpected EOF: " + self.proc.stderr.read().decode(errors="replace"))
+        length = struct.unpack(">I", prefix)[0]
+        if length < 12 or length > MAX_FRAME:
+            raise ValueError("invalid response frame length")
+        body = self.proc.stdout.read(length)
+        if len(body) != length:
+            raise ValueError("truncated response")
+        return body[:4], struct.unpack(">Q", body[4:12])[0], body[12:]
+
+    def write(self, data):
+        self.proc.stdin.write(data)
+        self.proc.stdin.flush()
+
+    def scan(self, batch_id, hex_oids):
+        oids = [bytes.fromhex(value) for value in hex_oids]
+        payload = struct.pack(">I", len(oids))
+        for oid in oids:
+            payload += struct.pack(">I", len(oid)) + oid
+        self.write(frame(b"BGIN", batch_id, payload))
+        result = {"batch": batch_id, "frames": [], "records": []}
+        continuation = None
+        while True:
+            tag, got_batch, payload = self.read()
+            name = tag.decode("ascii")
+            result["frames"].append(name)
+            if got_batch != batch_id:
+                raise ValueError("wrong batch ID")
+            if tag == b"BGIN":
+                if payload:
+                    raise ValueError("nonempty BGIN response")
+            elif tag == b"CMIT":
+                d = Decoder(payload)
+                oid, message, name_b, email = d.bytes(), d.bytes(), d.bytes(), d.bytes()
+                when, zone = d.u64(), d.u32()
+                has_author, has_time = d.take(1)[0], d.take(1)[0]
+                d.done()
+                result["records"].append({
+                    "kind": "commit", "oid": oid.hex(),
+                    "message": message.decode("utf-8", errors="surrogateescape"),
+                    "author": name_b.decode("utf-8", errors="surrogateescape"),
+                    "email": email.decode("utf-8", errors="surrogateescape"),
+                    "time": when, "zone": struct.unpack(">i", struct.pack(">I", zone))[0],
+                    "has_author": has_author, "has_time": has_time,
+                })
+            elif tag == b"FBEG":
+                d = Decoder(payload)
+                commit, status = d.bytes(), d.take(1).decode("ascii")
+                old_mode, new_mode = d.u32(), d.u32()
+                old_oid, new_oid = d.bytes(), d.bytes()
+                old_path, new_path = d.bytes(), d.bytes()
+                binary = d.take(1)[0]
+                d.done()
+                result["records"].append({
+                    "kind": "file", "commit": commit.hex(), "status": status,
+                    "old_mode": old_mode, "new_mode": new_mode,
+                    "old_oid": old_oid.hex(), "new_oid": new_oid.hex(),
+                    "old_path": base64.b64encode(old_path).decode(),
+                    "new_path": base64.b64encode(new_path).decode(),
+                    "binary": binary,
+                })
+            elif tag == b"HUNK":
+                d = Decoder(payload)
+                commit, path, position, added = d.bytes(), d.bytes(), d.u64(), d.bytes()
+                missing = d.take(1)[0]
+                d.done()
+                result["records"].append(hunk(commit, path, position, added, missing, False))
+            elif tag == b"HBGN":
+                d = Decoder(payload)
+                continuation = [d.bytes(), d.bytes(), d.u64(), bytearray()]
+                d.done()
+            elif tag == b"HADD":
+                if continuation is None or not payload:
+                    raise ValueError("invalid HADD")
+                continuation[3].extend(payload)
+            elif tag == b"HEND":
+                if continuation is None or payload not in (b"\0", b"\1"):
+                    raise ValueError("invalid HEND")
+                result["records"].append(hunk(*continuation, payload[0], True))
+                continuation = None
+            elif tag in (b"FEND", b"CEND"):
+                if payload:
+                    raise ValueError("nonempty end frame")
+            elif tag == b"ERRO":
+                d = Decoder(payload)
+                kind = d.take(1)[0]
+                op, message = d.bytes(), d.bytes()
+                d.done()
+                result["error"] = [kind, op.decode(), message.decode()]
+                return result
+            elif tag == b"BEND":
+                if len(payload) != 25:
+                    raise ValueError("invalid BEND")
+                status = payload[0]
+                counts = struct.unpack(">QQQ", payload[1:])
+                result["completion"] = [status, *counts]
+                return result
+            else:
+                raise ValueError("unexpected frame " + name)
+
+    def close(self):
+        self.write(frame(b"QUIT", 0))
+        self.proc.stdin.close()
+        status = self.proc.wait(timeout=10)
+        stderr = self.proc.stderr.read().decode(errors="replace")
+        if status or stderr:
+            raise ValueError(f"helper exit {status}: {stderr}")
+
+
+def hunk(commit, path, position, added, missing, continued):
+    return {
+        "kind": "hunk", "commit": commit.hex(),
+        "path": base64.b64encode(path).decode(), "position": position,
+        "length": len(added), "sha256": hashlib.sha256(added).hexdigest(),
+        "missing": missing, "continued": continued,
+        "added": base64.b64encode(added).decode() if len(added) < 4096 else None,
+    }
+
+
+def malformed(repo, mode):
+    client = Client(repo)
+    if mode == "short":
+        client.write(struct.pack(">I", 11) + b"x" * 11)
+    elif mode == "oversize":
+        client.write(struct.pack(">I", MAX_FRAME + 1))
+    elif mode == "badtag":
+        client.write(frame(b"NOPE", 1))
+    else:
+        raise ValueError(mode)
+    tag, batch, payload = client.read()
+    if tag != b"ERRO":
+        raise ValueError("malformed request did not return ERRO")
+    print(json.dumps({"tag": "ERRO", "batch": batch, "payload": payload.hex()}))
+    client.proc.stdin.close()
+    client.proc.wait(timeout=10)
+
+
+def unsupported(repo):
+    env = os.environ.copy()
+    env["GIT_TEST_BETTERLEAKS_UNSUPPORTED"] = "1"
+    proc = subprocess.Popen(
+        ["git", "-C", repo, "betterleaks--diff-engine", "--protocol=1"],
+        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        env=env,
+    )
+    prefix = proc.stdout.read(4)
+    length = struct.unpack(">I", prefix)[0]
+    body = proc.stdout.read(length)
+    if body[:4] != b"ERRO" or struct.unpack(">Q", body[4:12])[0] != 0 or body[12] != 5:
+        raise ValueError("expected pre-HELO unsupported ERRO")
+    proc.stdin.close()
+    if proc.wait(timeout=10):
+        raise ValueError(proc.stderr.read().decode(errors="replace"))
+    print(json.dumps({"tag": "ERRO", "batch": 0, "kind": 5}))
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--repo", default=".")
+    parser.add_argument("--malformed", choices=("short", "oversize", "badtag"))
+    parser.add_argument("--preflight-unsupported", action="store_true")
+    parser.add_argument("batches", nargs="*", help="comma-separated OIDs; '-' is empty")
+    args = parser.parse_args()
+    if args.malformed:
+        malformed(args.repo, args.malformed)
+        return
+    if args.preflight_unsupported:
+        unsupported(args.repo)
+        return
+    client = Client(args.repo)
+    results = []
+    for number, batch in enumerate(args.batches, 1):
+        results.append(client.scan(number, [] if batch == "-" else batch.split(",")))
+        if "error" in results[-1]:
+            client.proc.stdin.close()
+            client.proc.wait(timeout=10)
+            print(json.dumps(results, ensure_ascii=False, sort_keys=True))
+            return
+    client.close()
+    print(json.dumps(results, ensure_ascii=False, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
