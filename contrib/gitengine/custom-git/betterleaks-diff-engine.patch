diff --git a/betterleaks-engine-protocol.c b/betterleaks-engine-protocol.c
new file mode 100644
index 000000000..f1e8ecea4
--- /dev/null
+++ b/betterleaks-engine-protocol.c
@@ -0,0 +1,395 @@
+#include "git-compat-util.h"
+#include "betterleaks-engine-protocol.h"
+#include "diffcore.h"
+#include "repository.h"
+
+static void bl_put_be16(unsigned char *p, uint16_t v)
+{
+	p[0] = v >> 8;
+	p[1] = v;
+}
+
+static uint32_t bl_get_be32(const unsigned char *p)
+{
+	return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+	       ((uint32_t)p[2] << 8) | p[3];
+}
+
+static uint64_t bl_get_be64(const unsigned char *p)
+{
+	return ((uint64_t)bl_get_be32(p) << 32) | bl_get_be32(p + 4);
+}
+
+static void payload_u32(struct strbuf *sb, uint32_t v)
+{
+	unsigned char b[4];
+	put_be32(b, v);
+	strbuf_add(sb, b, sizeof(b));
+}
+
+static void payload_u64(struct strbuf *sb, uint64_t v)
+{
+	unsigned char b[8];
+	put_be64(b, v);
+	strbuf_add(sb, b, sizeof(b));
+}
+
+static void payload_bytes(struct strbuf *sb, const void *data, size_t len)
+{
+	if (len > UINT32_MAX)
+		die("betterleaks protocol field is too large");
+	payload_u32(sb, len);
+	strbuf_add(sb, data, len);
+}
+
+static void write_frame(struct betterleaks_protocol *p, const char tag[4],
+			uint64_t batch_id, const void *payload, size_t payload_len)
+{
+	unsigned char header[16];
+	uint64_t frame_len = 12 + payload_len;
+
+	if (frame_len > BETTERLEAKS_MAX_FRAME)
+		die("betterleaks protocol frame is too large");
+	put_be32(header, frame_len);
+	memcpy(header + 4, tag, 4);
+	put_be64(header + 8, batch_id);
+	if (fwrite(header, 1, sizeof(header), p->out) != sizeof(header) ||
+	    (payload_len && fwrite(payload, 1, payload_len, p->out) != payload_len))
+		die_errno("betterleaks protocol write failed");
+}
+
+static void flush_output(struct betterleaks_protocol *p)
+{
+	if (fflush(p->out))
+		die_errno("betterleaks protocol flush failed");
+}
+
+int betterleaks_read_frame(struct betterleaks_protocol *p,
+			   struct betterleaks_frame *frame)
+{
+	unsigned char prefix[4], header[12];
+	uint32_t len;
+
+	memset(frame, 0, sizeof(*frame));
+	strbuf_init(&frame->payload, 0);
+	if (fread(prefix, 1, sizeof(prefix), p->in) != sizeof(prefix)) {
+		if (feof(p->in))
+			return 0;
+		die_errno("betterleaks protocol read failed");
+	}
+	len = bl_get_be32(prefix);
+	if (len < 12 || len > BETTERLEAKS_MAX_FRAME)
+		return -1;
+	if (fread(header, 1, sizeof(header), p->in) != sizeof(header))
+		return -1;
+	memcpy(frame->tag, header, 4);
+	frame->batch_id = bl_get_be64(header + 4);
+	if (len > 12) {
+		strbuf_grow(&frame->payload, len - 12);
+		if (fread(frame->payload.buf, 1, len - 12, p->in) != len - 12)
+			return -1;
+		frame->payload.len = len - 12;
+		frame->payload.buf[frame->payload.len] = '\0';
+	}
+	return 1;
+}
+
+void betterleaks_frame_release(struct betterleaks_frame *frame)
+{
+	strbuf_release(&frame->payload);
+}
+
+void betterleaks_write_hello(struct betterleaks_protocol *p)
+{
+	unsigned char payload[6];
+	bl_put_be16(payload, BETTERLEAKS_PROTOCOL_VERSION);
+	bl_put_be16(payload + 2, p->oid_len);
+	payload[4] = payload[5] = 0;
+	write_frame(p, "HELO", 0, payload, sizeof(payload));
+	flush_output(p);
+}
+
+void betterleaks_write_batch_begin(struct betterleaks_protocol *p)
+{
+	write_frame(p, "BGIN", p->batch_id, NULL, 0);
+}
+
+void betterleaks_write_commit(struct betterleaks_protocol *p,
+			      const struct object_id *oid,
+			      const struct strbuf *message,
+			      const struct strbuf *author_name,
+			      const struct strbuf *author_email,
+			      int64_t author_time, int32_t author_tz,
+			      int has_author, int has_author_time)
+{
+	struct strbuf payload = STRBUF_INIT;
+	payload_bytes(&payload, oid->hash, p->oid_len);
+	payload_bytes(&payload, message->buf, message->len);
+	payload_bytes(&payload, author_name->buf, author_name->len);
+	payload_bytes(&payload, author_email->buf, author_email->len);
+	payload_u64(&payload, author_time);
+	payload_u32(&payload, author_tz);
+	strbuf_addch(&payload, !!has_author);
+	strbuf_addch(&payload, !!has_author_time);
+	write_frame(p, "CMIT", p->batch_id, payload.buf, payload.len);
+	strbuf_release(&payload);
+	p->commits++;
+}
+
+void betterleaks_write_commit_end(struct betterleaks_protocol *p)
+{
+	write_frame(p, "CEND", p->batch_id, NULL, 0);
+}
+
+void betterleaks_write_batch_end(struct betterleaks_protocol *p)
+{
+	unsigned char payload[25];
+	payload[0] = 0;
+	put_be64(payload + 1, p->commits);
+	put_be64(payload + 9, p->files);
+	put_be64(payload + 17, p->hunks);
+	write_frame(p, "BEND", p->batch_id, payload, sizeof(payload));
+	flush_output(p);
+}
+
+void betterleaks_write_error(struct betterleaks_protocol *p, uint64_t batch_id,
+			     unsigned char kind, const char *op,
+			     const char *message)
+{
+	struct strbuf payload = STRBUF_INIT;
+	strbuf_addch(&payload, kind);
+	payload_bytes(&payload, op, strlen(op));
+	payload_bytes(&payload, message, strlen(message));
+	write_frame(p, "ERRO", batch_id, payload.buf, payload.len);
+	strbuf_release(&payload);
+	flush_output(p);
+}
+
+static void emit_file_begin(struct betterleaks_protocol *p)
+{
+	struct strbuf payload = STRBUF_INIT;
+	struct object_id old_oid = { .algo = p->commit_oid.algo };
+	struct object_id new_oid = { .algo = p->commit_oid.algo };
+	const char *old_path, *new_path;
+
+	if (p->file_emitted)
+		return;
+	old_path = p->one && p->one->path ? p->one->path : "";
+	new_path = p->two && p->two->path ? p->two->path : "";
+	if (p->one)
+		oidcpy(&old_oid, &p->one->oid);
+	if (p->two)
+		oidcpy(&new_oid, &p->two->oid);
+	payload_bytes(&payload, p->commit_oid.hash, p->oid_len);
+	strbuf_addch(&payload, p->pair->status);
+	payload_u32(&payload, p->one ? p->one->mode : 0);
+	payload_u32(&payload, p->two ? p->two->mode : 0);
+	payload_bytes(&payload, old_oid.hash, p->oid_len);
+	payload_bytes(&payload, new_oid.hash, p->oid_len);
+	payload_bytes(&payload, old_path, strlen(old_path));
+	payload_bytes(&payload, new_path, strlen(new_path));
+	strbuf_addch(&payload, !!p->file_binary);
+	write_frame(p, "FBEG", p->batch_id, payload.buf, payload.len);
+	strbuf_release(&payload);
+	p->file_emitted = 1;
+	p->files++;
+}
+
+static void write_hunk_begin(struct betterleaks_protocol *p)
+{
+	struct strbuf payload = STRBUF_INIT;
+	const char *path = p->two && p->two->path ? p->two->path : "";
+	payload_bytes(&payload, p->commit_oid.hash, p->oid_len);
+	payload_bytes(&payload, path, strlen(path));
+	payload_u64(&payload, p->hunk_position);
+	write_frame(p, "HBGN", p->batch_id, payload.buf, payload.len);
+	strbuf_release(&payload);
+}
+
+static void write_hadd(struct betterleaks_protocol *p, const char *data, size_t len)
+{
+	size_t max = BETTERLEAKS_MAX_FRAME - 12;
+	while (len) {
+		size_t n = len > max ? max : len;
+		write_frame(p, "HADD", p->batch_id, data, n);
+		data += n;
+		len -= n;
+	}
+}
+
+static size_t hunk_metadata_size(struct betterleaks_protocol *p)
+{
+	const char *path = p->two && p->two->path ? p->two->path : "";
+	return 4 + p->oid_len + 4 + strlen(path) + 8 + 4 + 1;
+}
+
+static void hunk_data(struct betterleaks_protocol *p, const char *data, size_t len)
+{
+	if (!len)
+		return;
+	if (!p->hunk_continued &&
+	    p->hunk.len + len + hunk_metadata_size(p) <= BETTERLEAKS_MAX_FRAME - 12) {
+		strbuf_add(&p->hunk, data, len);
+		return;
+	}
+	if (!p->hunk_continued) {
+		write_hunk_begin(p);
+		write_hadd(p, p->hunk.buf, p->hunk.len);
+		strbuf_reset(&p->hunk);
+		p->hunk_continued = 1;
+	}
+	write_hadd(p, data, len);
+}
+
+static void flush_pending(struct betterleaks_protocol *p)
+{
+	if (p->pending_valid) {
+		hunk_data(p, &p->pending, 1);
+		p->pending_valid = 0;
+	}
+}
+
+static void finish_hunk(struct betterleaks_protocol *p, int missing)
+{
+	struct strbuf payload = STRBUF_INIT;
+	const char *path;
+	if (!p->hunk_open)
+		return;
+	flush_pending(p);
+	path = p->two && p->two->path ? p->two->path : "";
+	if (p->hunk_continued) {
+		unsigned char value = !!missing;
+		write_frame(p, "HEND", p->batch_id, &value, 1);
+	} else {
+		payload_bytes(&payload, p->commit_oid.hash, p->oid_len);
+		payload_bytes(&payload, path, strlen(path));
+		payload_u64(&payload, p->hunk_position);
+		payload_bytes(&payload, p->hunk.buf, p->hunk.len);
+		strbuf_addch(&payload, !!missing);
+		write_frame(p, "HUNK", p->batch_id, payload.buf, payload.len);
+	}
+	strbuf_release(&payload);
+	strbuf_reset(&p->hunk);
+	p->hunk_open = p->hunk_continued = p->pending_valid = 0;
+	p->hunks++;
+}
+
+static void sink_file_begin(void *data, struct diff_filepair *pair,
+			    struct diff_filespec *one,
+			    struct diff_filespec *two)
+{
+	struct betterleaks_protocol *p = data;
+	if (p->file_open)
+		BUG("betterleaks native file opened twice");
+	p->pair = pair;
+	p->one = one;
+	p->two = two;
+	p->file_open = 1;
+	p->file_emitted = p->file_binary = 0;
+}
+
+static void sink_file_binary(void *data)
+{
+	struct betterleaks_protocol *p = data;
+	if (!p->file_open)
+		BUG("betterleaks binary marker outside file");
+	p->file_binary = 1;
+}
+
+static void sink_hunk_begin(void *data, unsigned long new_line)
+{
+	struct betterleaks_protocol *p = data;
+	if (!p->file_open)
+		BUG("betterleaks hunk outside file");
+	finish_hunk(p, 0);
+	emit_file_begin(p);
+	p->hunk_open = 1;
+	p->hunk_position = new_line;
+	p->last_line = DIFF_NATIVE_LINE_CONTEXT;
+}
+
+static void sink_line(void *data, enum diff_native_line kind,
+		      const char *line, size_t len)
+{
+	struct betterleaks_protocol *p = data;
+	if (!p->hunk_open && kind != DIFF_NATIVE_LINE_NO_LF_EOF)
+		return;
+	if (kind == DIFF_NATIVE_LINE_INCOMPLETE) {
+		if (p->last_line == DIFF_NATIVE_LINE_PLUS) {
+			if (p->pending_valid && p->pending == '\n')
+				p->pending_valid = 0;
+			else
+				flush_pending(p);
+			finish_hunk(p, 1);
+		}
+		return;
+	}
+	if (kind == DIFF_NATIVE_LINE_NO_LF_EOF) {
+		if (p->last_line == DIFF_NATIVE_LINE_PLUS) {
+			flush_pending(p);
+			finish_hunk(p, 1);
+		}
+		return;
+	}
+	flush_pending(p);
+	if (kind == DIFF_NATIVE_LINE_PLUS && len) {
+		if (len > 1)
+			hunk_data(p, line, len - 1);
+		p->pending = line[len - 1];
+		p->pending_valid = 1;
+	}
+	p->last_line = kind;
+}
+
+static void sink_file_end(void *data)
+{
+	struct betterleaks_protocol *p = data;
+	if (!p->file_open)
+		BUG("betterleaks native file ended while closed");
+	finish_hunk(p, 0);
+	emit_file_begin(p);
+	write_frame(p, "FEND", p->batch_id, NULL, 0);
+	p->file_open = p->file_emitted = 0;
+	p->pair = NULL;
+	p->one = p->two = NULL;
+}
+
+void betterleaks_protocol_init(struct betterleaks_protocol *p, FILE *in,
+			       FILE *out, size_t oid_len)
+{
+	memset(p, 0, sizeof(*p));
+	p->in = in;
+	p->out = out;
+	p->oid_len = oid_len;
+	strbuf_init(&p->hunk, 0);
+	p->sink.data = p;
+	p->sink.file_begin = sink_file_begin;
+	p->sink.file_binary = sink_file_binary;
+	p->sink.hunk_begin = sink_hunk_begin;
+	p->sink.line = sink_line;
+	p->sink.file_end = sink_file_end;
+}
+
+void betterleaks_protocol_release(struct betterleaks_protocol *p)
+{
+	strbuf_release(&p->hunk);
+}
+
+void betterleaks_protocol_set_batch(struct betterleaks_protocol *p,
+				    uint64_t batch_id)
+{
+	p->batch_id = batch_id;
+	p->commits = p->files = p->hunks = 0;
+}
+
+void betterleaks_protocol_set_commit(struct betterleaks_protocol *p,
+				     const struct object_id *oid)
+{
+	oidcpy(&p->commit_oid, oid);
+}
+
+void betterleaks_protocol_assert_closed(struct betterleaks_protocol *p)
+{
+	if (p->file_open || p->hunk_open || p->pending_valid)
+		BUG("betterleaks protocol record left open");
+}
diff --git a/betterleaks-engine-protocol.h b/betterleaks-engine-protocol.h
new file mode 100644
index 000000000..0338404e6
--- /dev/null
+++ b/betterleaks-engine-protocol.h
@@ -0,0 +1,61 @@
+#ifndef BETTERLEAKS_ENGINE_PROTOCOL_H
+#define BETTERLEAKS_ENGINE_PROTOCOL_H
+
+#include "diff.h"
+#include "hash.h"
+#include "strbuf.h"
+
+#define BETTERLEAKS_PROTOCOL_VERSION 1
+#define BETTERLEAKS_MAX_FRAME (16U << 20)
+
+struct betterleaks_frame {
+	char tag[4];
+	uint64_t batch_id;
+	struct strbuf payload;
+};
+
+struct betterleaks_protocol {
+	FILE *in;
+	FILE *out;
+	size_t oid_len;
+	uint64_t batch_id, commits, files, hunks;
+	struct object_id commit_oid;
+	struct diff_native_sink sink;
+	struct diff_filepair *pair;
+	struct diff_filespec *one, *two;
+	int file_open, file_emitted, file_binary;
+	int hunk_open, hunk_continued;
+	uint64_t hunk_position;
+	struct strbuf hunk;
+	int pending_valid;
+	char pending;
+	enum diff_native_line last_line;
+};
+
+void betterleaks_protocol_init(struct betterleaks_protocol *p, FILE *in,
+			       FILE *out, size_t oid_len);
+void betterleaks_protocol_release(struct betterleaks_protocol *p);
+int betterleaks_read_frame(struct betterleaks_protocol *p,
+			   struct betterleaks_frame *frame);
+void betterleaks_frame_release(struct betterleaks_frame *frame);
+void betterleaks_write_hello(struct betterleaks_protocol *p);
+void betterleaks_write_batch_begin(struct betterleaks_protocol *p);
+void betterleaks_write_commit(struct betterleaks_protocol *p,
+			      const struct object_id *oid,
+			      const struct strbuf *message,
+			      const struct strbuf *author_name,
+			      const struct strbuf *author_email,
+			      int64_t author_time, int32_t author_tz,
+			      int has_author, int has_author_time);
+void betterleaks_write_commit_end(struct betterleaks_protocol *p);
+void betterleaks_write_batch_end(struct betterleaks_protocol *p);
+void betterleaks_write_error(struct betterleaks_protocol *p, uint64_t batch_id,
+			     unsigned char kind, const char *op,
+			     const char *message);
+void betterleaks_protocol_set_batch(struct betterleaks_protocol *p,
+				    uint64_t batch_id);
+void betterleaks_protocol_set_commit(struct betterleaks_protocol *p,
+				     const struct object_id *oid);
+void betterleaks_protocol_assert_closed(struct betterleaks_protocol *p);
+
+#endif
