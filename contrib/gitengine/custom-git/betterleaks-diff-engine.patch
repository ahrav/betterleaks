@@ -0,0 +1,168 @@
+#!/bin/sh
+
+test_description='experimental Betterleaks typed diff engine protocol'
+
+. ./test-lib.sh
+
+client="$TEST_DIRECTORY/helper/betterleaks-engine-client.py"
+test_lazy_prereq PYTHON3 'python3 -c "import sys"'
+
+test_expect_success PYTHON3 'create text, rename, mode, binary, and huge fixtures' '
+	test_create_repo fixture &&
+	(
+		cd fixture &&
+		printf "alpha\nbeta\n" >file.txt &&
+		git add file.txt &&
+		git commit -m "root title" &&
+		git rev-parse HEAD >../root.oid &&
+		printf "alpha\ngamma" >file.txt &&
+		git commit -am "modify without newline" &&
+		git rev-parse HEAD >../modify.oid &&
+		git mv file.txt renamed.txt &&
+		git commit -m rename &&
+		git rev-parse HEAD >../rename.oid &&
+		chmod +x renamed.txt &&
+		git commit -am mode &&
+		git rev-parse HEAD >../mode.oid &&
+		printf "binary\000payload" >binary.dat &&
+		git add binary.dat &&
+		git commit -m binary &&
+		git rev-parse HEAD >../binary.oid &&
+		git mv binary.dat binary-renamed.dat &&
+		git commit -m binary-rename &&
+		git rev-parse HEAD >../binary-rename.oid &&
+		python3 -c "import sys; sys.stdout.write(chr(120) * ((17 << 20) + 7) + chr(10))" >huge.txt &&
+		git add huge.txt &&
+		git commit -m huge &&
+		git rev-parse HEAD >../huge.oid &&
+		printf "unicode\302\205\n\nConflicts:\n\tpath\n" >../whitespace.message &&
+		git commit --allow-empty -F ../whitespace.message &&
+		git rev-parse HEAD >../whitespace.oid &&
+		git tag -a rejected-tag -m tag HEAD &&
+		git rev-parse rejected-tag >../tag.oid &&
+		git checkout -b side &&
+		printf "side\n" >side.txt &&
+		git add side.txt &&
+		git commit -m side &&
+		git checkout master &&
+		printf "main\n" >main.txt &&
+		git add main.txt &&
+		git commit -m main &&
+		git merge --no-ff -m merge side &&
+		git rev-parse HEAD >../merge.oid &&
+		git update-index --add --cacheinfo 160000,$(cat ../root.oid),renamed.txt &&
+		git commit -m typechange &&
+		git rev-parse HEAD >../typechange.oid &&
+		git rm binary-renamed.dat &&
+		git commit -m delete &&
+		git rev-parse HEAD >../delete.oid
+	)
+'
+
+test_expect_success PYTHON3 'handshake and full record semantics' '
+	oids="$(cat root.oid),$(cat modify.oid),$(cat rename.oid),$(cat mode.oid),$(cat binary.oid),$(cat binary-rename.oid),$(cat huge.oid),$(cat whitespace.oid)" &&
+	python3 "$client" --repo fixture "$oids" >actual.json &&
+	python3 - actual.json <<-"PY"
+	import json, sys
+	batch = json.load(open(sys.argv[1]))[0]
+	assert batch["frames"][0] == "BGIN"
+	assert batch["frames"][-1] == "BEND"
+	assert batch["completion"][0] == 0
+	records = batch["records"]
+	commits = [r for r in records if r["kind"] == "commit"]
+	files = [r for r in records if r["kind"] == "file"]
+	hunks = [r for r in records if r["kind"] == "hunk"]
+	assert len(commits) == 8
+	assert commits[0]["message"] == "root title"
+	assert commits[-1]["message"] == "unicode\n\nConflicts:\n        path"
+	assert all(r["has_author"] and r["has_time"] for r in commits)
+	assert any(r["status"] == "R" for r in files)
+	assert any(r["old_mode"] != r["new_mode"] for r in files)
+	assert any(r["binary"] for r in files)
+	import base64
+	binary_rename = next(r for r in files if base64.b64decode(r["new_path"]) == b"binary-renamed.dat")
+	assert binary_rename["status"] == "R" and not binary_rename["binary"]
+	assert any(r["missing"] for r in hunks)
+	assert any(r["continued"] and r["length"] > (16 << 20) for r in hunks)
+	assert batch["completion"][1:] == [len(commits), len(files), len(hunks)]
+	PY
+'
+
+test_expect_success PYTHON3 'sequential batches reset request-local state' '
+	python3 "$client" --repo fixture - "$(cat root.oid)" "$(cat modify.oid)" "$(cat root.oid)" >actual.json &&
+	python3 - actual.json <<-"PY"
+	import json, sys
+	batches = json.load(open(sys.argv[1]))
+	assert batches[0]["completion"] == [0, 0, 0, 0]
+	assert batches[1]["completion"][1] == 1
+	assert batches[2]["completion"][1] == 1
+	assert batches[3]["completion"][1] == 1
+	assert [batch["batch"] for batch in batches] == [1, 2, 3, 4]
+	assert batches[1]["records"][0]["oid"] == batches[3]["records"][0]["oid"]
+	PY
+'
+
+test_expect_success PYTHON3 'merge diffs and excluded type-change/delete statuses emit commits only' '
+	oids="$(cat merge.oid),$(cat typechange.oid),$(cat delete.oid)" &&
+	python3 "$client" --repo fixture "$oids" >filtered.json &&
+	python3 - filtered.json <<-"PY"
+	import json, sys
+	b = json.load(open(sys.argv[1]))[0]
+	assert b["completion"] == [0, 3, 0, 0]
+	assert [r["kind"] for r in b["records"]] == ["commit", "commit", "commit"]
+	PY
+'
+
+test_expect_success PYTHON3 'missing, tag, and non-adjacent duplicate OIDs are terminal rejections' '
+	missing=$(printf "%040d" 0 | tr 0 f) &&
+	python3 "$client" --repo fixture "$missing" >missing.json &&
+	python3 "$client" --repo fixture "$(cat tag.oid)" >tag.json &&
+	python3 "$client" --repo fixture "$(cat root.oid),$(cat modify.oid),$(cat root.oid)" >duplicate.json &&
+	python3 - missing.json tag.json duplicate.json <<-"PY"
+	import json, sys
+	missing, tag, duplicate = (json.load(open(p))[0] for p in sys.argv[1:])
+	assert missing["error"][0] == 2
+	assert tag["error"][0] == 2
+	assert duplicate["error"][0] == 1
+	assert "duplicate" in duplicate["error"][2]
+	PY
+'
+
+test_expect_success PYTHON3 'short, oversized, and unknown frames are rejected' '
+	python3 "$client" --repo fixture --malformed short >short.json &&
+	python3 "$client" --repo fixture --malformed oversize >oversize.json &&
+	python3 "$client" --repo fixture --malformed badtag >badtag.json &&
+	grep ERRO short.json &&
+	grep ERRO oversize.json &&
+	grep ERRO badtag.json
+'
+
+test_expect_success PYTHON3 'unsupported preflight is ERRO kind 5 before HELO' '
+	python3 "$client" --repo fixture --preflight-unsupported >unsupported.json &&
+	grep "kind.*5" unsupported.json
+'
+
+test_lazy_prereq SHA256_ENGINE '
+	git init --bare --object-format=sha256 sha256-probe.git
+'
+
+test_expect_success PYTHON3,SHA256_ENGINE 'SHA-256 raw object IDs are negotiated and scanned' '
+	git init --object-format=sha256 sha256-probe &&
+	(
+		cd sha256-probe &&
+		printf "sha256\n" >file &&
+		git add file &&
+		git commit -m sha256 &&
+		git rev-parse HEAD >../sha256.oid
+	) &&
+	python3 "$client" --repo sha256-probe "$(cat sha256.oid)" >sha256.json &&
+	python3 - sha256.json <<-"PY"
+	import json, sys
+	b = json.load(open(sys.argv[1]))[0]
+	c = next(r for r in b["records"] if r["kind"] == "commit")
+	assert len(c["oid"]) == 64
+	assert b["completion"][1] == 1
+	PY
+'
+
+test_done
