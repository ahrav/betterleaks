diff --git a/builtin/betterleaks--diff-engine.c b/builtin/betterleaks--diff-engine.c
new file mode 100644
index 000000000..aed62d86e
--- /dev/null
+++ b/builtin/betterleaks--diff-engine.c
@@ -0,0 +1,443 @@
+#include "builtin.h"
+#include "betterleaks-engine-protocol.h"
+#include "commit.h"
+#include "config.h"
+#include "diff.h"
+#include "diffcore.h"
+#include "ident.h"
+#include "hex.h"
+#include "log-tree.h"
+#include "mailmap.h"
+#include "parse-options.h"
+#include "pretty.h"
+#include "replace-object.h"
+#include "revision.h"
+
+static const char * const betterleaks_engine_usage[] = {
+	N_("git betterleaks--diff-engine --protocol=1"),
+	NULL
+};
+
+static uint32_t bl_get_be32(const unsigned char *p)
+{
+	return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+	       ((uint32_t)p[2] << 8) | p[3];
+}
+
+static int parse_request(struct repository *repo,
+			 struct betterleaks_frame *frame,
+			 struct object_id **oids_out, size_t *nr_out,
+			 struct strbuf *error)
+{
+	const unsigned char *data = (unsigned char *)frame->payload.buf;
+	size_t len = frame->payload.len, pos = 0;
+	struct object_id *oids = NULL;
+	uint32_t count;
+
+	if (len < 4) {
+		strbuf_addstr(error, "BGIN payload is truncated");
+		return -1;
+	}
+	count = bl_get_be32(data);
+	pos = 4;
+	if (count > (len - pos) / (4 + repo->hash_algo->rawsz)) {
+		strbuf_addstr(error, "BGIN commit count exceeds payload");
+		return -1;
+	}
+	CALLOC_ARRAY(oids, count);
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t oid_len;
+		if (len - pos < 4) {
+			strbuf_addstr(error, "BGIN object ID length is truncated");
+			goto fail;
+		}
+		oid_len = bl_get_be32(data + pos);
+		pos += 4;
+		if (oid_len != repo->hash_algo->rawsz || len - pos < oid_len) {
+			strbuf_addstr(error, "BGIN object ID has wrong width");
+			goto fail;
+		}
+		oidread(&oids[i], data + pos, repo->hash_algo);
+		pos += oid_len;
+		for (uint32_t j = 0; j < i; j++) {
+			if (oideq(&oids[i], &oids[j])) {
+				strbuf_addstr(error, "BGIN contains a duplicate object ID");
+				goto fail;
+			}
+		}
+	}
+	if (pos != len) {
+		strbuf_addstr(error, "BGIN has trailing payload bytes");
+		goto fail;
+	}
+	*oids_out = oids;
+	*nr_out = count;
+	return 0;
+
+fail:
+	free(oids);
+	return -1;
+}
+
+static size_t unicode_space_len(const char *p, const char *end)
+{
+	const unsigned char *s = (const unsigned char *)p;
+	size_t len = end - p;
+
+	if (!len)
+		return 0;
+	if (*s == ' ' || (*s >= '\t' && *s <= '\r'))
+		return 1;
+	if (len >= 2 && s[0] == 0xc2 && (s[1] == 0x85 || s[1] == 0xa0))
+		return 2;
+	if (len >= 3 && s[0] == 0xe1 && s[1] == 0x9a && s[2] == 0x80)
+		return 3;
+	if (len >= 3 && s[0] == 0xe2 && s[1] == 0x80 &&
+	    ((s[2] >= 0x80 && s[2] <= 0x8a) ||
+	     s[2] == 0xa8 || s[2] == 0xa9 || s[2] == 0xaf))
+		return 3;
+	if (len >= 3 && s[0] == 0xe2 && s[1] == 0x81 && s[2] == 0x9f)
+		return 3;
+	if (len >= 3 && s[0] == 0xe3 && s[1] == 0x80 && s[2] == 0x80)
+		return 3;
+	return 0;
+}
+
+static const char *trim_unicode_left(const char *begin, const char *end)
+{
+	size_t len;
+
+	while ((len = unicode_space_len(begin, end)) != 0)
+		begin += len;
+	return begin;
+}
+
+static const char *trim_unicode_right(const char *begin, const char *end)
+{
+	const char *p = begin, *trimmed = begin;
+
+	while (p < end) {
+		size_t len = unicode_space_len(p, end);
+		if (len) {
+			p += len;
+		} else {
+			p++;
+			trimmed = p;
+		}
+	}
+	return trimmed;
+}
+
+static void normalize_medium_message(const struct strbuf *pretty,
+				     struct strbuf *message)
+{
+	const char *line, *end = pretty->buf + pretty->len;
+	const char *indent = NULL;
+	size_t indent_len = 0;
+	int in_title = 1, have_title = 0, have_body = 0;
+	int blank_body = 0, skip_body = 0;
+
+	line = strstr(pretty->buf, "\n\n");
+	if (!line)
+		return;
+	line += 2;
+	while (line < end) {
+		const char *eol = memchr(line, '\n', end - line);
+		const char *begin = line;
+		const char *finish = eol ? eol : end;
+		if (in_title) {
+			begin = trim_unicode_left(begin, finish);
+			finish = trim_unicode_right(begin, finish);
+			if (begin == finish) {
+				skip_body = !have_title;
+				in_title = 0;
+			} else {
+				if (!indent) {
+					indent = line;
+					indent_len = begin - line;
+				}
+				if (have_title)
+					strbuf_addch(message, ' ');
+				strbuf_add(message, begin, finish - begin);
+				have_title = 1;
+			}
+		} else if (!skip_body) {
+			finish = trim_unicode_right(begin, finish);
+			if (indent_len && (size_t)(finish - begin) >= indent_len &&
+			    !memcmp(begin, indent, indent_len))
+				begin += indent_len;
+			if (begin == finish) {
+				if (have_body)
+					blank_body = 1;
+			} else {
+				if (!have_body)
+					strbuf_addstr(message, "\n\n");
+				else {
+					strbuf_addch(message, '\n');
+					if (blank_body)
+						strbuf_addch(message, '\n');
+				}
+				strbuf_add(message, begin, finish - begin);
+				have_body = 1;
+				blank_body = 0;
+			}
+		}
+		line = eol ? eol + 1 : end;
+	}
+}
+
+static int parse_tz(const struct ident_split *ident, int32_t *offset)
+{
+	const char *tz = ident->tz_begin;
+	int sign, hours, minutes;
+	if (!tz || ident->tz_end - tz != 5)
+		return -1;
+	sign = *tz++ == '-' ? -1 : 1;
+	if (!isdigit(tz[0]) || !isdigit(tz[1]) ||
+	    !isdigit(tz[2]) || !isdigit(tz[3]))
+		return -1;
+	hours = (tz[0] - '0') * 10 + tz[1] - '0';
+	minutes = (tz[2] - '0') * 10 + tz[3] - '0';
+	if (hours > 23 || minutes > 59)
+		return -1;
+	*offset = sign * (hours * 60 + minutes);
+	return 0;
+}
+
+static void write_commit_metadata(struct repository *repo,
+				  struct rev_info *rev,
+				  struct betterleaks_protocol *protocol,
+				  struct commit *commit)
+{
+	struct pretty_print_context pp = { 0 };
+	struct strbuf pretty = STRBUF_INIT, block = STRBUF_INIT;
+	struct strbuf message = STRBUF_INIT, mapped = STRBUF_INIT;
+	struct strbuf name = STRBUF_INIT, email = STRBUF_INIT;
+	struct ident_split ident;
+	const char *buffer, *author;
+	size_t author_len;
+	int has_author = 0, has_time = 0;
+	int64_t timestamp = 0;
+	int32_t tz = 0;
+
+	pp.fmt = CMIT_FMT_MEDIUM;
+	pp.date_mode = rev->date_mode;
+	pp.date_mode_explicit = 1;
+	pp.mailmap = rev->mailmap;
+	pp.output_encoding = "UTF-8";
+	pp.rev = rev;
+	pp.expand_tabs_in_log = 8;
+	pretty_print_commit(&pp, commit, &pretty);
+	strbuf_addf(&block, "commit %s\n", oid_to_hex(&commit->object.oid));
+	strbuf_addbuf(&block, &pretty);
+	normalize_medium_message(&block, &message);
+
+	buffer = repo_get_commit_buffer(repo, commit, NULL);
+	author = find_commit_header(buffer, "author", &author_len);
+	if (author && !split_ident_line(&ident, author, author_len)) {
+		char *end;
+		has_author = 1;
+		repo_format_commit_message(repo, commit, "%aN%x00%aE", &mapped, &pp);
+		if (mapped.len) {
+			const char *nul = memchr(mapped.buf, '\0', mapped.len);
+			if (nul) {
+				strbuf_add(&name, mapped.buf, nul - mapped.buf);
+				strbuf_add(&email, nul + 1,
+					   mapped.buf + mapped.len - (nul + 1));
+			}
+		}
+		if (ident.date_begin && ident.date_end &&
+		    ident.tz_begin && ident.tz_end && !parse_tz(&ident, &tz)) {
+			timestamp = strtoll(ident.date_begin, &end, 10);
+			if (end == ident.date_end)
+				has_time = 1;
+		}
+	}
+	repo_unuse_commit_buffer(repo, commit, buffer);
+	betterleaks_write_commit(protocol, &commit->object.oid, &message,
+				   &name, &email, timestamp, tz,
+				   has_author, has_time);
+	strbuf_release(&pretty);
+	strbuf_release(&block);
+	strbuf_release(&message);
+	strbuf_release(&mapped);
+	strbuf_release(&name);
+	strbuf_release(&email);
+}
+
+static int setup_batch_revision(struct repository *repo, struct rev_info *rev,
+				struct diff_native_sink *sink,
+				struct string_list *mailmap)
+{
+	const char *argv[] = {
+		"betterleaks--diff-engine", "-p", "-U0", "--root",
+		"--no-diff-merges", "-M50%", "--full-index",
+		"--src-prefix=a/", "--dst-prefix=b/", "--no-color",
+		"--no-ext-diff", "--textconv", "--diff-algorithm=myers",
+		"--indent-heuristic", "--no-notes", "--no-show-signature",
+		"--diff-filter=tuxdb",
+	};
+	struct setup_revision_opt opt = { 0 };
+	int argc;
+
+	repo_init_revisions(repo, rev, NULL);
+	rev->abbrev = 0;
+	rev->diff = 1;
+	rev->disable_stdin = 1;
+	argc = setup_revisions(ARRAY_SIZE(argv), argv, rev, &opt);
+	if (argc != 1)
+		return error("betterleaks revision profile left %d arguments (%s)",
+			     argc, argc > 1 ? argv[1] : "none");
+	rev->no_commit_id = 1;
+	rev->mailmap = mailmap;
+	rev->diffopt.no_free = 1;
+	rev->diffopt.native_sink = sink;
+	rev->diffopt.file = xfopen("/dev/null", "w");
+	rev->diffopt.close_file = 1;
+	return 0;
+}
+
+static int process_batch(struct repository *repo,
+			 struct betterleaks_protocol *protocol,
+			 struct string_list *mailmap,
+			 struct betterleaks_frame *frame)
+{
+	struct object_id *oids = NULL;
+	struct commit **commits = NULL;
+	struct strbuf error = STRBUF_INIT;
+	size_t nr = 0;
+	struct rev_info rev;
+	int ret = -1;
+
+	if (!frame->batch_id) {
+		betterleaks_write_error(protocol, 0, 1, "BGIN",
+					 "batch ID must be nonzero");
+		goto out;
+	}
+	if (parse_request(repo, frame, &oids, &nr, &error)) {
+		betterleaks_write_error(protocol, frame->batch_id, 1, "BGIN",
+					 error.buf);
+		goto out;
+	}
+	CALLOC_ARRAY(commits, nr);
+	for (size_t i = 0; i < nr; i++) {
+		commits[i] = lookup_commit_object(repo, &oids[i]);
+		if (!commits[i] || repo_parse_commit(repo, commits[i])) {
+			strbuf_reset(&error);
+			strbuf_addf(&error, "object %s is not a readable commit",
+				    oid_to_hex(&oids[i]));
+			betterleaks_write_error(protocol, frame->batch_id, 2,
+						 "lookup commit", error.buf);
+			goto out;
+		}
+	}
+	if (setup_batch_revision(repo, &rev, &protocol->sink, mailmap)) {
+		betterleaks_write_error(protocol, frame->batch_id, 2,
+					 "revision setup", "profile setup failed");
+		goto out;
+	}
+	betterleaks_protocol_set_batch(protocol, frame->batch_id);
+	betterleaks_write_batch_begin(protocol);
+	for (size_t i = 0; i < nr; i++) {
+		struct commit_list *parents;
+		rev.diffopt.found_changes = 0;
+		rev.diffopt.flags.has_changes = 0;
+		rev.diffopt.flags.check_failed = 0;
+		rev.shown_dashes = 0;
+		betterleaks_protocol_set_commit(protocol, &oids[i]);
+		write_commit_metadata(repo, &rev, protocol, commits[i]);
+		log_tree_commit(&rev, commits[i]);
+		betterleaks_protocol_assert_closed(protocol);
+		if (!diff_queue_is_empty(&rev.diffopt))
+			BUG("betterleaks diff queue was not drained");
+		betterleaks_write_commit_end(protocol);
+		free_commit_buffer(repo->parsed_objects, commits[i]);
+		for (parents = commits[i]->parents; parents; parents = parents->next)
+			free_commit_buffer(repo->parsed_objects, parents->item);
+	}
+	rev.diffopt.native_sink = NULL;
+	rev.diffopt.no_free = 0;
+	rev.mailmap = NULL;
+	release_revisions(&rev);
+	betterleaks_write_batch_end(protocol);
+	ret = 0;
+
+out:
+	strbuf_release(&error);
+	free(commits);
+	free(oids);
+	return ret;
+}
+
+int cmd_betterleaks__diff_engine(int argc, const char **argv,
+				 const char *prefix,
+				 struct repository *repo)
+{
+	struct betterleaks_protocol protocol;
+	struct string_list mailmap = STRING_LIST_INIT_NODUP;
+	int protocol_version = 0;
+	struct option options[] = {
+		OPT_INTEGER(0, "protocol", &protocol_version,
+			    N_("binary protocol version")),
+		OPT_END()
+	};
+
+	BUG_ON_NON_EMPTY_PREFIX(prefix);
+	argc = parse_options(argc, argv, prefix, options,
+			     betterleaks_engine_usage, 0);
+	if (argc || protocol_version != BETTERLEAKS_PROTOCOL_VERSION)
+		usage_with_options(betterleaks_engine_usage, options);
+	repo_config(repo, git_diff_basic_config, NULL);
+	prepare_repo_settings(repo);
+	disable_replace_refs();
+	read_mailmap(&mailmap);
+	betterleaks_protocol_init(&protocol, stdin, stdout, repo->hash_algo->rawsz);
+	if (repo->hash_algo->rawsz != 20 && repo->hash_algo->rawsz != 32) {
+		betterleaks_write_error(&protocol, 0, 5, "preflight",
+					 "unsupported object ID width");
+		betterleaks_protocol_release(&protocol);
+		clear_mailmap(&mailmap);
+		return 0;
+	}
+	if (git_env_bool("GIT_TEST_BETTERLEAKS_UNSUPPORTED", 0)) {
+		betterleaks_write_error(&protocol, 0, 5, "preflight",
+					 "test-only unsupported capability");
+		betterleaks_protocol_release(&protocol);
+		clear_mailmap(&mailmap);
+		return 0;
+	}
+	betterleaks_write_hello(&protocol);
+	for (;;) {
+		struct betterleaks_frame frame;
+		int read = betterleaks_read_frame(&protocol, &frame);
+		if (read <= 0) {
+			if (read < 0)
+				betterleaks_write_error(&protocol, 0, 1, "read frame",
+							 "malformed or truncated frame");
+			else
+				betterleaks_write_error(&protocol, 0, 1, "read frame",
+							 "EOF before QUIT");
+			betterleaks_frame_release(&frame);
+			break;
+		}
+		if (!memcmp(frame.tag, "QUIT", 4) && !frame.batch_id &&
+		    !frame.payload.len) {
+			betterleaks_frame_release(&frame);
+			break;
+		}
+		if (memcmp(frame.tag, "BGIN", 4)) {
+			betterleaks_write_error(&protocol, frame.batch_id, 1,
+						 "request", "expected BGIN or QUIT");
+			betterleaks_frame_release(&frame);
+			break;
+		}
+		if (process_batch(repo, &protocol, &mailmap, &frame)) {
+			betterleaks_frame_release(&frame);
+			break;
+		}
+		betterleaks_frame_release(&frame);
+	}
+	betterleaks_protocol_release(&protocol);
+	clear_mailmap(&mailmap);
+	return 0;
+}
