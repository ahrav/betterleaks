+/* Fast path: the hash value is an internal bucketing key only — every
+ * classifier hit is verified by xdl_recmatch (content equality), and
+ * downstream diffing uses canonical class indices, never raw hashes.
+ * Any hash function therefore yields byte-identical diff output.
+ * memchr vectorizes the newline scan and XXH3 vectorizes the hash;
+ * the original DJB2 loop was a 2-op/byte serial dependency chain that
+ * dominated xdl_prepare_ctx in whole-history `log -p` profiles. */
 unsigned long xdl_hash_record(char const **data, char const *top, long flags) {
-	unsigned long ha = 5381;
 	char const *ptr = *data;
+	char const *nl, *end;
 
 	if (flags & XDF_WHITESPACE_FLAGS)
 		return xdl_hash_record_with_whitespace(data, top, flags);
 
-	for (; ptr < top && *ptr != '\n'; ptr++) {
-		ha += (ha << 5);
-		ha ^= (unsigned long) *ptr;
-	}
-	*data = ptr < top ? ptr + 1: ptr;
+	nl = memchr(ptr, '\n', top - ptr);
+	end = nl ? nl : top;
+	*data = nl ? nl + 1 : top;
 
-	return ha;
+	return (unsigned long) XXH3_64bits(ptr, (size_t) (end - ptr));
 }
 
